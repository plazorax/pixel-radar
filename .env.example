# Dashboard password. Leave unset to disable login (local use only).
PIXEL_RADAR_PASSWORD=
# Optional: keeps sessions valid across restarts. Any long random string.
PIXEL_RADAR_SESSION_SECRET=
# Path to the sites config (default: ./sites.json).
PIXEL_RADAR_CONFIG=
# Server bind address and port.
HOST=127.0.0.1
PORT=3000
# Behind a TLS-terminating reverse proxy: Express "trust proxy" value, e.g. 1 or loopback.
TRUST_PROXY=
